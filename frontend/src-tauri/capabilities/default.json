{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-kill",
    "shell:allow-stdin-write",
    "dialog:default",
    "notification:default"
  ],
  "shell": {
    "scope": [
      { "name": "backend", "cmd": "**/criminal-llm", "args": true },
      { "name": "backend-exe", "cmd": "**/criminal-llm.exe", "args": true },
      { "name": "open", "cmd": "open", "args": true }
    ]
  }
}
