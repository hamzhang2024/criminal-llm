{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "刑事案卷分析系统",
  "version": "0.9.94",
  "identifier": "com.criminal-pdf.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null
    },
    "resources": [
      "resources/backend/**/*"
    ]
  }
}
