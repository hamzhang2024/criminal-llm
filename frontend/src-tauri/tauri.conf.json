{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Criminal-Case-Analyzer",
  "version": "1.7.1",
  "identifier": "com.criminal-pdf.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "resources": [
      "resources/backend/**/*"
    ]
  }
}
