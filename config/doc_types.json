{
  "_comment": "刑事案卷文书类型配置 - 基于《刑事诉讼法》第50条证据种类",
  "_version": "2.0",
  "_updated": "2026-03-27",
  "_reference": "《刑事诉讼法》第50条规定证据种类：物证、书证、证人证言、被害人陈述、犯罪嫌疑人/被告人供述和辩解、鉴定意见、勘验/检查/辨认/侦查实验等笔录、视听资料/电子数据",
  
  "evidence_types": {
    "物证": {
      "description": "以外部特征证明案件真实情况的物品",
      "keywords": ["作案工具", "赃物", "凶器", "毒品", "管制刀具", "涉案物品", "扣押物品"],
      "examples": ["作案工具照片", "赃物清单", "毒品鉴定报告附件"]
    },
    "书证": {
      "description": "以文字、符号、图形记载的内容证明案件真实情况的书面材料",
      "keywords": ["合同", "协议", "票据", "账册", "银行流水", "转账记录", "欠条", "借条", "收据", "发票", "书面材料"],
      "examples": ["借款合同", "银行转账凭证", "微信聊天记录截图", "通话记录"]
    },
    "证人证言": {
      "description": "证人就其所了解的案件情况向公安司法机关所作的陈述",
      "keywords": ["询问笔录", "证人.*证言", "证人.*陈述", "见证人"],
      "examples": ["询问笔录（证人）", "证人证言"]
    },
    "被害人陈述": {
      "description": "被害人就其所了解的案件情况向公安司法机关所作的陈述",
      "keywords": ["被害人.*陈述", "被害人.*询问", "受害人.*笔录"],
      "examples": ["被害人询问笔录", "被害人陈述"]
    },
    "犯罪嫌疑人供述和辩解": {
      "description": "犯罪嫌疑人、被告人就案件事实向公安司法机关所作的口头或书面陈述",
      "keywords": ["讯问笔录", "供述", "辩解", "自首.*材料", "坦白.*材料", "亲笔供词"],
      "examples": ["讯问笔录", "犯罪嫌疑人供述", "自首材料"]
    },
    "鉴定意见": {
      "description": "鉴定人运用专门知识对案件中的专门性问题进行分析判断后出具的意见",
      "keywords": ["鉴定.*意见", "鉴定报告", "法医学.*鉴定", "DNA.*鉴定", "指纹.*鉴定", "痕迹.*鉴定", "物证.*鉴定", "会计.*鉴定", "价格.*鉴定", "精神.*鉴定", "毒物.*鉴定"],
      "examples": ["法医鉴定意见书", "DNA鉴定报告", "价格认定结论书"]
    },
    "勘验检查辨认侦查实验笔录": {
      "description": "公安司法人员对与犯罪有关的场所、物品、人身、尸体进行勘验、检查或组织辨认、侦查实验时制作的笔录",
      "keywords": ["勘验.*笔录", "现场.*勘验", "检查.*笔录", "辨认.*笔录", "侦查实验.*笔录", "搜查.*笔录", "提取.*笔录"],
      "examples": ["现场勘验笔录", "人身检查笔录", "辨认笔录", "侦查实验笔录"]
    },
    "视听资料电子数据": {
      "description": "以录音、录像、电子计算机或其他高科技设备所存储的信息证明案件真实情况的资料",
      "keywords": ["视听资料", "监控.*录像", "录音", "录像", "电子数据", "手机.*提取", "电脑.*提取", "聊天记录", "通话记录", "微信.*记录", "支付宝.*记录"],
      "examples": ["监控录像", "手机电子数据提取笔录", "微信聊天记录"]
    }
  },
  
  "procedural_docs": {
    "卷宗封面": {
      "keywords": ["刑事.*卷宗", "案件名称", "案件编号", "犯罪嫌疑人.*姓名", "立案时间", "结案时间"],
      "priority": 1
    },
    "卷内目录": {
      "keywords": ["卷内.*目录", "文书.*目录", "本卷.*页号"],
      "priority": 2
    },
    "受案登记表": {
      "keywords": ["受案登记表", "受案.*字号", "受案时间", "报案人.*信息"],
      "category": "立案文书",
      "priority": 3
    },
    "立案决定书": {
      "keywords": ["立案决定书", "立案.*决定", "不予立案.*通知书"],
      "category": "立案文书",
      "priority": 4
    },
    "拘留证": {
      "keywords": ["拘留证", "刑事拘留.*决定书", "拘留.*通知书"],
      "category": "强制措施",
      "priority": 10
    },
    "逮捕证": {
      "keywords": ["逮捕证", "批准逮捕.*决定书", "逮捕.*通知书"],
      "category": "强制措施",
      "priority": 11
    },
    "取保候审决定书": {
      "keywords": ["取保候审.*决定书", "取保.*手续", "保证金.*收据"],
      "category": "强制措施",
      "priority": 12
    },
    "监视居住决定书": {
      "keywords": ["监视居住.*决定书", "监视居住.*通知书"],
      "category": "强制措施",
      "priority": 13
    },
    "释放通知书": {
      "keywords": ["释放.*通知书", "释放.*证明书"],
      "category": "强制措施",
      "priority": 14
    },
    "提讯提解证": {
      "keywords": ["提讯.*提解", "提讯.*时间", "提解.*登记"],
      "category": "强制措施",
      "priority": 15
    },
    "侦破经过": {
      "keywords": ["刑事案件.*侦破经过", "抓获经过", "到案经过", "破案经过", "发案.*经过"],
      "category": "侦查文书",
      "priority": 20
    },
    "搜查证": {
      "keywords": ["搜查证", "搜查.*笔录", "搜查.*照片"],
      "category": "侦查文书",
      "priority": 21
    },
    "扣押清单": {
      "keywords": ["扣押.*清单", "扣押.*决定书", "查封.*清单"],
      "category": "侦查文书",
      "priority": 22
    },
    "起诉意见书": {
      "keywords": ["起诉.*意见书", "移送.*审查起诉", "公安.*起诉"],
      "category": "结案文书",
      "priority": 100
    },
    "移送起诉告知书": {
      "keywords": ["移送.*起诉.*告知书", "告知.*审查起诉"],
      "category": "结案文书",
      "priority": 101
    }
  },
  
  "suspect_docs": {
    "权利义务告知书": {
      "keywords": ["权利义务.*告知书", "诉讼.*权利.*告知", "委托.*辩护人.*告知书"],
      "per_suspect": true
    },
    "讯问笔录": {
      "keywords": ["讯问.*笔录", "犯罪嫌疑人.*供述"],
      "per_suspect": true
    },
    "亲笔供词": {
      "keywords": ["亲笔.*供词", "自书.*材料"],
      "per_suspect": true
    },
    "辨认笔录": {
      "keywords": ["辨认.*笔录", "辨认.*照片.*说明"],
      "per_suspect": true
    },
    "犯罪嫌疑人照片": {
      "keywords": ["犯罪嫌疑人.*照片", "照片.*姓名", "免冠.*照片", "三面照"],
      "per_suspect": true
    },
    "户籍证明": {
      "keywords": ["户籍.*证明", "户口.*本", "人口.*信息", "常住.*人口"],
      "per_suspect": true
    },
    "前科材料": {
      "keywords": ["前科", "刑事.*判决书", "释放.*证明", "处罚.*决定书", "劳动.*教养"],
      "per_suspect": true
    },
    "身份证": {
      "keywords": ["居民身份证", "身份.*证.*复印"],
      "per_suspect": true
    }
  },
  
  "doc_groups": {
    "01_卷宗封面": {
      "doc_types": ["卷宗封面", "卷内目录"],
      "description": "案卷封面和目录"
    },
    "02_受立案手续": {
      "doc_types": ["受案登记表", "立案决定书"],
      "description": "立案程序性文书"
    },
    "03_强制措施": {
      "doc_types": ["拘留证", "逮捕证", "取保候审决定书", "监视居住决定书", "释放通知书", "提讯提解证"],
      "description": "强制措施相关文书"
    },
    "04_侦查文书": {
      "doc_types": ["侦破经过", "搜查证", "扣押清单"],
      "description": "侦查活动相关文书"
    },
    "05_嫌疑人材料": {
      "per_suspect": true,
      "doc_types": ["权利义务告知书", "讯问笔录", "亲笔供词", "辨认笔录", "犯罪嫌疑人照片", "户籍证明", "前科材料", "身份证"],
      "description": "按嫌疑人分组的材料（同一嫌疑人材料放一起）"
    },
    "06_证人证言": {
      "evidence_type": "证人证言",
      "doc_types": ["询问笔录"],
      "description": "证人证言类证据"
    },
    "07_被害人陈述": {
      "evidence_type": "被害人陈述",
      "doc_types": ["被害人陈述"],
      "description": "被害人陈述类证据"
    },
    "08_物证书证": {
      "evidence_type": "物证",
      "evidence_types": ["物证", "书证"],
      "description": "物证、书证类证据"
    },
    "09_鉴定意见": {
      "evidence_type": "鉴定意见",
      "description": "鉴定意见类证据"
    },
    "10_勘验检查笔录": {
      "evidence_type": "勘验检查辨认侦查实验笔录",
      "description": "勘验、检查、辨认、侦查实验笔录"
    },
    "11_视听资料电子数据": {
      "evidence_type": "视听资料电子数据",
      "description": "视听资料、电子数据类证据"
    },
    "12_起诉意见书": {
      "doc_types": ["起诉意见书", "移送起诉告知书"],
      "description": "结案文书"
    }
  },
  
  "boundary_detection": {
    "title_patterns": [
      "第[一二三四五六七八九十百千万]+卷",
      "^[一二三四五六七八九十]+[、.．]",
      "^[（(][一二三四五六七八九十]+[)）]",
      "^[0-9]+[、.．]",
      "^附[：:]"
    ],
    "page_break_threshold": 0.8,
    "content_similarity_threshold": 0.7
  },
  
  "ocr_settings": {
    "language": "chi_sim",
    "output_type": "pdf",
    "optimize": 3,
    "rotate_pages": true,
    "deskew": true,
    "clean": true
  }
}